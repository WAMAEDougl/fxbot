# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored - never commit real secrets.
#
# Design rules (trading-system-design.md 8):
#  - Broker API keys MUST be scoped to trading only. No withdrawal permission, ever.
#  - The research plane gets NO broker credentials. Only run scripts/backfill.py
#    and scripts/run_backtest.py / validate.py with the vars above the RESEARCH line.
#  - Two environments, paper and live, identical code, different credentials,
#    visually distinct in every log line. Set TS_ENV accordingly.
# ---------------------------------------------------------------------------

# Which environment this process is. Drives log labelling / dashboard colour and
# is checked before any live order path. One of: paper | live
TS_ENV=paper

# Where the parquet data lake lives (scripts/backfill.py --lake overrides this).
TS_LAKE_DIR=data_lake

# Where local state (portfolio DB, OMS journal) and the audit log are written.
TS_STATE_DIR=state
TS_AUDIT_DIR=audit


# === RESEARCH PLANE ONLY ABOVE THIS LINE ===================================
# Everything below is execution-plane. Do not load it in research jobs.


# --- Interactive Brokers (equities + spot FX) ------------------------------
# Needs a running TWS or IB Gateway. Paper trading uses port 7497 (TWS) /
# 4002 (Gateway); live uses 7496 / 4001. Keep the paper and live values in
# SEPARATE .env files.
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=21
# IB account id, e.g. DU1234567 (paper) or U1234567 (live). Leave blank to let
# ib_async pick the sole account on the connection.
IB_ACCOUNT=

# --- Strategy registry signing -------------------------------------------
# HMAC secret used to sign promoted strategy configs (research/registry.py).
# Rotate if leaked; a bad signature blocks the config from loading into live.
# Replace with an asymmetric keypair before real capital (see README "Next").
TS_REGISTRY_SECRET=change-me-to-a-long-random-string

# --- Alerting (ops/alerting.py) ----------------------------------------
# Telegram bot for severity-tiered alerts. You want to be woken for a
# kill-switch trip, not for a fill.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: SMTP for email alerts instead of / alongside Telegram.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Kill switch (ops/killswitch.py) ---------------------------------
# Path to the on-disk flag file the engine polls. `touch` it to halt all new
# orders immediately; delete it to resume.
TS_KILLSWITCH_FILE=state/HALT
# Automatic-trip thresholds (fractions / counts / seconds).
TS_DAILY_LOSS_LIMIT=0.03
TS_MAX_REJECTIONS_PER_5MIN=5
TS_FEED_STALE_AFTER_S=180

# --- Reconciliation (execution/reconcile.py) ------------------------
# How often to reconcile local state against the broker, and the tolerances
# beyond which new orders are halted.
TS_RECONCILE_INTERVAL_S=300
TS_RECONCILE_QTY_TOLERANCE=0.000001
TS_RECONCILE_EQUITY_TOLERANCE_FRAC=0.005

# --- Vendor market data (production backfill) ----------------------
# Free tiers have history limits that make real backtesting impossible; use a
# paid feed for anything past the learning stage.
POLYGON_API_KEY=
DATABENTO_API_KEY=
ALPHAVANTAGE_API_KEY=
